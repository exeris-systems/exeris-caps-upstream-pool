<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.caps</groupId>
    <artifactId>exeris-caps-upstream-pool</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Exeris Caps :: Upstream Pool &amp; Load Balancing</name>
    <description>
        High-performance, zero-allocation upstream pool, load balancing and health check capability.
        Implements Round-Robin, Least-Connections, Weighted Round-Robin, IP-hash and random selection without locks or steady-state allocation, active background probing,
        passive outlier detection under a cluster-level ejection budget, and fail-open selection for Exeris Gateways.
    </description>
    <url>https://github.com/exeris-systems/exeris-caps-upstream-pool</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <!-- commercial per ADR-023 / ADR-099 — source-available under the Exeris Commercial License -->
    <licenses>
        <license>
            <name>Exeris Commercial License</name>
            <url>https://exeris.eu/licenses/commercial-1.1.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <exeris.sdk.version>0.12.0</exeris.sdk.version>
        <exeris.kernel.version>0.13.0-SNAPSHOT</exeris.kernel.version>
        <exeris.tooling.version>0.10.0</exeris.tooling.version>

        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.7</assertj.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
            <version>${exeris.sdk.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Kernel SPI: EntitlementRequirement, the licence gate's input -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
            <version>${exeris.kernel.version}</version>
        </dependency>

        <!-- Licence-gate tests: the TCK, the kernel's boot path and a driver for it. Test scope only. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-tck</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-core</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <version>${exeris.kernel.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>eu.exeris</groupId>
                            <artifactId>exeris-processor</artifactId>
                            <version>${exeris.tooling.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-codegen-maven-plugin</artifactId>
                <version>${exeris.tooling.version}</version>
                <executions>
                    <execution>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate</goal>
                            <goal>verify-capabilities</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
